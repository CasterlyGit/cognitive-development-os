{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CasterlyGit/cognitive-development-os/contracts/krish-handoff-v1.schema.json",
  "title": "Krish Handoff Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_id",
    "idempotency_key",
    "intent_id",
    "plan_id",
    "plan_digest",
    "target_system",
    "target_project",
    "action",
    "outcome",
    "owned_paths",
    "acceptance_criteria",
    "exclusions",
    "evidence_contract",
    "risk",
    "permission_class",
    "approval_receipt_id",
    "required_merge_policy"
  ],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^1\\."},
    "handoff_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "intent_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "minLength": 1},
    "target_system": {"const": "krish"},
    "target_project": {"type": "string", "minLength": 1},
    "action": {"const": "draft_issue_proposal"},
    "outcome": {"type": "string", "minLength": 1},
    "owned_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "evidence_contract": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk": {"enum": ["low", "medium", "high"]},
    "permission_class": {"const": "P1_draft_only"},
    "approval_receipt_id": {"type": "null"},
    "required_merge_policy": {"const": "human_only"}
  }
}
